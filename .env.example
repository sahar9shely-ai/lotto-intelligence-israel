# Global
PROJECT_NAME=תזרים
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=lotto_intelligence
POSTGRES_USER=lotto_user
POSTGRES_PASSWORD=lotto_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=tazrim-dev-secret-change-me-32chars!
APP_PUBLIC_URL=http://localhost:8000

# Optional SMTP (not required — password resets are manager-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Frontend
FRONTEND_PORT=5173
# Leave empty so the UI calls /api on the same origin
VITE_API_BASE_URL=
# Production static files (set automatically by Docker / start-production.sh)
# FRONTEND_DIST=
# INVESTMENTS_DB_PATH=

