# Global
PROJECT_NAME=תזרים
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=lotto_intelligence
POSTGRES_USER=lotto_user
POSTGRES_PASSWORD=lotto_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=tazrim-dev-secret-change-me-32chars!
APP_PUBLIC_URL=http://localhost:5173

# Optional SMTP for real email delivery (Gmail example)
# Create an App Password in Google Account, then:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Without SMTP: the app shows a direct reset link on screen after forgot-password

# Frontend
FRONTEND_PORT=5173
# Leave empty in local/dev to use Vite proxy (/api -> backend)
VITE_API_BASE_URL=

